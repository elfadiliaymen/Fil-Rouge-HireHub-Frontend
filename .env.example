# HireHub Frontend - configuration
# Copy to .env and adjust. NEVER commit the real .env file.
# Vite exposes only VITE_* variables to the browser at build time.

# Base URL of the HireHub backend REST API (must end with /api).
# All endpoints are relative to this prefix:
#   Auth:      POST /auth/register, POST /auth/login, POST /auth/logout
#   Users:     GET/POST/PUT/PATCH/DELETE /users..., GET /users/stats
#   Offres:    GET/POST/PUT/DELETE /offres..., GET /offres/type/{type}
#   CV:        GET/POST/PUT/DELETE /cv..., POST /cv/upload, GET /cv/download/{cvId}
#   Candidatures: GET/POST/PATCH/DELETE /candidatures...
#   Entretiens: GET/POST/PUT/DELETE /entretiens...
#   Profile:   GET /me, POST /me/password
#   Docs:      /v3/api-docs, /swagger-ui.html
VITE_API_URL=http://localhost:8090/api